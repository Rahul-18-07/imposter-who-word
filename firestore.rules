rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid in ['REPLACE_WITH_YOUR_UID'];
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /games/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /customCategories/{categoryId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && (
            !request.resource.data.keys().hasAny(['entries']) ||
            (
              request.resource.data.entries.size() >= 1 &&
              request.resource.data.entries.size() <= 50
            )
          )
          && (
            !request.resource.data.keys().hasAny(['name']) ||
            (
              request.resource.data.name.size() >= 1 &&
              request.resource.data.name.size() <= 40
            )
          );
      }
    }
  }
}
